<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background shape of the switch -->
    <item
        android:width="48dp"
        android:height="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#D3D3D3" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Thumb (circle) on the left -->
    <item
        android:width="18dp"
        android:height="18dp"
        android:gravity="center_vertical|start"
        android:left="3dp">
        <shape android:shape="oval">
            <solid android:color="#C8A2C8" />
        </shape>
    </item>

    <!-- Icon for the inactive state (assuming the same icon for now) -->
    <item
        android:width="18dp"
        android:height="18dp"
        android:drawable="@drawable/sports_esports_24px"
        android:gravity="center_vertical|end"
        android:right="3dp" />
</layer-list>
